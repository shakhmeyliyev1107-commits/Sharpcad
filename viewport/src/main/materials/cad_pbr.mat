// Physically based look without scene lights or environment maps: GGX specular with
// Schlick Fresnel from a fixed key light, a sky/ground hemisphere for ambient light and
// a sky gradient for reflections. Unlit model, so colours do not depend on exposure.
// Per-vertex appearance: custom1 = (base colour linear rgb, roughness), custom2 = metallic.
material {
    name : cad_pbr,
    requires : [ custom0, custom1, custom2 ],
    shadingModel : unlit,
    culling : none,
    variables : [ worldNormal, appearance, extra ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.worldNormal.xyz = getWorldFromModelNormalMatrix() * getCustom0().xyz;
        material.appearance = getCustom1();
        material.extra = vec4(getCustom2().x, 0.0, 0.0, 0.0);
    }
}

fragment {
    float ggx(float nh, float a) {
        float a2 = a * a;
        float d = nh * nh * (a2 - 1.0) + 1.0;
        return a2 / (3.14159265 * d * d);
    }

    float smith(float nv, float nl, float a) {
        float k = (a + 1.0) * (a + 1.0) / 8.0;
        return (nv / (nv * (1.0 - k) + k)) * (nl / (nl * (1.0 - k) + k));
    }

    vec3 sky(vec3 dir, float rough) {
        vec3 zenith = vec3(0.62, 0.70, 0.82);
        vec3 horizon = vec3(0.95, 0.96, 0.98);
        vec3 ground = vec3(0.16, 0.17, 0.19);
        vec3 sharp = dir.z >= 0.0 ? mix(horizon, zenith, sqrt(dir.z)) : mix(horizon * 0.6, ground, sqrt(-dir.z));
        vec3 blurred = mix(ground, zenith, clamp(dir.z * 0.5 + 0.5, 0.0, 1.0));
        return mix(sharp, blurred, rough);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 base = variable_appearance.rgb;
        float roughness = clamp(variable_appearance.a, 0.04, 1.0);
        float metallic = clamp(variable_extra.x, 0.0, 1.0);

        vec3 v = normalize(getWorldCameraPosition() - getWorldPosition());
        vec3 n = normalize(variable_worldNormal.xyz);
        if (dot(n, v) < 0.0) n = -n; // two-sided: shells may be open
        float nv = max(dot(n, v), 1e-4);

        vec3 f0 = mix(vec3(0.04), base, metallic);
        vec3 diffuse = base * (1.0 - metallic);
        float a = roughness * roughness;

        // Key light from above and slightly in front of the viewer.
        vec3 l = normalize(vec3(0.35, -0.45, 0.82) + v * 0.35);
        vec3 h = normalize(l + v);
        float nl = max(dot(n, l), 0.0);
        float nh = max(dot(n, h), 0.0);
        vec3 fresnel = f0 + (1.0 - f0) * pow(1.0 - max(dot(h, v), 0.0), 5.0);
        vec3 specular = ggx(nh, a) * smith(nv, nl, a) * fresnel / (4.0 * nv + 1e-4);
        vec3 key = (diffuse * (1.0 - fresnel) + specular) * nl * 2.2;

        // Ambient from the hemisphere plus a soft headlight so every face reads.
        vec3 ambient = diffuse * (sky(n, 1.0) * 0.55 + 0.25 * nv);
        vec3 fresnelEnv = f0 + (max(vec3(1.0 - roughness), f0) - f0) * pow(1.0 - nv, 5.0);
        vec3 reflection = sky(reflect(-v, n), roughness) * fresnelEnv;

        material.baseColor = vec4(min(key + ambient + reflection, vec3(1.0)), 1.0);
    }
}
